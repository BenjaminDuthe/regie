# regie — réseau interne de la capture (histoire 4.2). Aucune route vers Internet ni vers le LXC : le seul voisin
# joignable est proxy-capture (adresse fixe). Pas de DNS : le navigateur ne résout rien, le proxy résout.
[Network]
NetworkName=capture-interne
Driver=bridge
Internal=true
DisableDNS=true
Subnet=10.89.77.0/24
Gateway=10.89.77.1
