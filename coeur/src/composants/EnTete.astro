---
// En-tête collant commun (UX-DR4) : nom regie. L'espace actif et la navigation (Relire,
// Démos d'app) s'y ajoutent avec les pages qui les portent (histoires 1.9, 2.12 et 4.x).
---

<header class="entete">
  <a class="nom" href="/">regie</a>
</header>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: max(10px, env(safe-area-inset-top)) 16px 10px;
    background: var(--surface);
    border-bottom: 1px solid var(--trait);
  }
  .nom {
    color: var(--texte);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
</style>
