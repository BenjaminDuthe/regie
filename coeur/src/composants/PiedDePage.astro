---
// Pied de page commun : lien vers le code source de la version en service (FR-67, AGPL-3.0),
// discret, sur chaque page.
import chaines from '../chaines.json' with { type: 'json' };
import { env } from '../env.ts';
import { lienSource } from '../source.ts';

const version = env.REGIE_VERSION;
const numero = version?.slice(0, 7) ?? chaines.pied.versionDeveloppement;
---

<footer class="pied">
  <a href={lienSource(version)} rel="noopener">{chaines.pied.lienSource}</a>
  <span>· {chaines.pied.version.replace('{version}', numero)}</span>
  <span>· <a href="/confidentialite">{chaines.pied.confidentialite}</a></span>
  <span>· <a href="/conditions">{chaines.pied.conditions}</a></span>
</footer>

<style>
  .pied {
    max-width: 1240px;
    margin: 0 auto;
    padding: 16px 16px max(16px, env(safe-area-inset-bottom));
    color: var(--doux);
    font-size: 12px;
    border-top: 1px solid var(--trait);
  }
  .pied a {
    color: var(--doux);
  }
</style>
