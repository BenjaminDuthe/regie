---
// Page d'accueil.
import chaines from '../chaines.json' with { type: 'json' };
import Base from '../mises-en-page/Base.astro';
---

<Base titre={chaines.marque}>
  <h1>{chaines.accueil.titre}</h1>
  <p class="intro">{chaines.accueil.intro}</p>
</Base>

<style>
  h1 {
    font-size: clamp(24px, 6vw, 36px);
    line-height: 1.15;
    margin: 8px 0 12px;
  }
  .intro {
    color: var(--doux);
    max-width: 60ch;
    margin: 0;
  }
</style>
