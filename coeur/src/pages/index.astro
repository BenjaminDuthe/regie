---
// Page d'accueil.
import Base from '../mises-en-page/Base.astro';
---

<Base titre="regie">
  <h1>regie — ton studio de vidéos verticales</h1>
  <p class="intro">Tu déposes tes rushes, Claude prépare tes brouillons, tu gardes ceux qui te plaisent.</p>
</Base>

<style>
  h1 {
    font-size: clamp(24px, 6vw, 36px);
    line-height: 1.15;
    margin: 8px 0 12px;
  }
  .intro {
    color: var(--doux);
    max-width: 60ch;
    margin: 0;
  }
</style>
