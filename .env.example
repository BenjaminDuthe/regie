# regie — variables d'environnement lues par coeur/src/env.ts (seul lecteur, AR-5).
# Rien ne charge ce fichier tout seul : exporte ces variables dans ton shell avant
# `npm run start --workspace coeur`, ou omets-les pour garder les défauts. Aucune valeur réelle ici.

# development | production | test (défaut : production)
NODE_ENV=development
# Adresse d'écoute du cœur (défaut : 127.0.0.1 ; le conteneur fixe 0.0.0.0)
HOTE=127.0.0.1
# Port d'écoute du cœur (défaut : 4321)
PORT=4321
